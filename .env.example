# Copy this file to .env and replace every value. NEVER commit .env.
# On a Radiant VM keep the production .env outside the repository, readable
# only by the account that runs the web service.
# Generate strong values with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- database (includes/db.php; php/data.php, php/admin_ingest.php, tools/) --
# DB_DRIVER picks the engine: pgsql (PostgreSQL, the default and the Radiant
# target, owner Q-06) or mysql (never deployed; removed after go-live, D-017).
# On Radiant each tier has its own file (pri-district-tracker-test.env,
# pri-district-tracker-live.env) and NCSA supplies the values marked TBD at the move.
# DB_USER is the application role <app>_app (rows only: SELECT, INSERT, UPDATE).
# The owner role <app>_owner runs tools/migrate.php from a separate owner file;
# it never sits in the file the running app reads.
# On the portable drive the PostgreSQL credentials need no .env: with DB_NAME unset,
# includes/db.php reads <dataFolder>/pg.env, which points at the estate cluster on
# the drive (127.0.0.1 port 5433, platform D-028).
DB_DRIVER=pgsql
# TBD at the move: the Radiant PostgreSQL host and port (5432 when left empty).
DB_HOST=
DB_PORT=
# disable, allow, prefer, require, verify-ca or verify-full; empty = the driver default.
DB_SSLMODE=
# The tier's database, <app>_test or <app>_live (NCSA's naming pattern is TBD;
# on the drive the names are district_tracker and district_tracker_test).
DB_NAME=
DB_USER=
DB_PASSWORD=
# The test database for DT_DB_TARGET=test; its name must end in _test.
DB_TEST_NAME=
# test points includes/db.php at DB_TEST_NAME (tests and tools/load-pg.php --test).
# Leave empty in both Radiant tier files: each tier names its own DB_NAME.
DT_DB_TARGET=
# The calendar the display timer follows on PostgreSQL (default America/Chicago).
APP_TIMEZONE=America/Chicago

# --- identity: the campus login proxy (includes/auth.php, D-018) -------------
# The proxy verifies the NetID and passes it in headers. TBD at the move: the
# header names NCSA's proxy sends. Empty = the defaults shown in the comments.
# AUTH_USER_HEADER      default X-Forwarded-User   (the NetID)
# AUTH_EMAIL_HEADER     default X-Forwarded-Email  (the campus address)
# AUTH_GROUPS_HEADER    default X-Forwarded-Groups (the campus groups)
# AUTH_GROUPS_SEPARATOR default ","  (use ";" for a Shibboleth isMemberOf header)
# AUTH_NETID_DOMAINS    default illinois.edu (address domains that carry a NetID)
AUTH_USER_HEADER=
AUTH_EMAIL_HEADER=
AUTH_GROUPS_HEADER=
AUTH_GROUPS_SEPARATOR=
AUTH_NETID_DOMAINS=

# --- authority: role by NetID or campus group (D-018) -------------------------
# The user_roles table (tools/roles.php, run as the owner role) holds the grants.
# These lists are the fallback, counted together with the table; the highest
# role wins. Each is comma-separated NetIDs, addresses and group:<name> entries.
# viewer reads the back office; editor saves, edits and retires; admin also
# imports CSV.
AUTH_ADMINS=
AUTH_EDITORS=
AUTH_VIEWERS=
# The allowlist before D-018; each address listed is an admin.
ADMIN_EMAILS=

# --- back office -------------------------------------------------------------
# Writes are allowed by default (owner, 2026-10-12, D-019); 0 makes the back
# office read-only. The Data Console stays the editor of record: a publish
# reload (tools/load-pg.php --refresh) overwrites a record edited here.
DT_BACKOFFICE_WRITES=

# --- local development only --------------------------------------------------
# Stand in for the proxy's headers when running on your machine (a NetID or an
# address, and a list of groups). MUST be empty on Radiant.
DEV_USER=
DEV_GROUPS=
